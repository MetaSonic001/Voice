# Where the brain API runs (python app.py). Copy to .env.local to change it.
# "/" = same address as the UI (the Docker image's default; on AWS the load balancer routes /v1/* to the brain).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Only if the brain has API_KEY set. Local testing only: anything NEXT_PUBLIC_ is visible in the browser.
# NEXT_PUBLIC_API_KEY=
