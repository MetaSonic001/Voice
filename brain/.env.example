# Copy to .env. Only GROQ_API_KEY is needed for local development; everything else has a working default.
# Uncomment a line only when you need what it says. Names are case-insensitive (see app/config.py).

GROQ_API_KEY=gsk_your_key_here

# ── LLM ── when: moving off Groq (production on AWS uses Bedrock; credentials come from the IAM role)
# LLM_PROVIDER=bedrock                 # openai (default: any OpenAI-compatible API, Groq) | bedrock
# AWS_REGION=ap-south-1
# UNDERSTAND_MODEL=openai/gpt-oss-20b  # Bedrock: an India geo profile ID (in.…, Mumbai + Hyderabad); never apac./global (ADR 0026)
# ANSWER_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1   # another OpenAI-compatible provider (OpenAI, Azure, vLLM)

# ── Voice ── when: text-only testing (VOICE_ENABLED=false loads no voice models), or switching to Sarvam
# VOICE_ENABLED=true
# SARVAM_API_KEY=                      # check it with: uv run python -m app.cli sarvam-check --out-dir sarvam-check (about Rs 2)
# STT_PROVIDER=sarvam                  # groq (default, Whisper) | sarvam
# TTS_PROVIDER=sarvam                  # edge (default, free, dev only) | sarvam
# SARVAM_STT_MODEL=saaras:v4           # saaras:v4 (key terms from STT_VOCABULARY) | saaras:v3 (same price)
# SARVAM_STT_MODE=codemix              # transcribe | codemix (Hinglish stays Hinglish) | translit | verbatim
# SARVAM_TTS_MODEL=bulbul:v4-flash     # bulbul:v4-flash (Rs 2 / 1,000 chars, 60 req/min) | bulbul:v3 (Rs 3, 30 req/min)
# SARVAM_V4_SPEAKERS=en:ishita_en_customer,hi:ishita_hi_banking,hinglish:ishita_enhi_customer   # v4 personas per language
# SARVAM_SPEAKER=priya                 # bulbul:v3 / v2 only (bare names; v4-flash refuses them)
# SARVAM_PACE=1.0                      # 0.5-2.0, tune by ear (v4-flash at 1.0 is already ~6-7% faster than v3)
# SPEECH_FALLBACK=true                 # Sarvam fails -> that request uses Whisper / Edge; out of credits -> backup until restart
# TTS_SPEED_PCT=10                     # how much faster than the voice's normal pace (Edge rate / Sarvam pace)

# ── Call audit ── when: deploying for real (recording key from the key vault, retention from bank policy)
# MAX_LIVE_CALLS=9                     # live calls this process takes at once; more are refused as busy. 0 = no limit
# RECORD_CALLS=true                    # live calls (stereo) and voice notes are recorded, encrypted
# RECORDING_KEY=                       # base64 of 32 random bytes (AES-256). Empty = a local key file (dev only; FILE_STORE=s3 refuses to start without it)
#                                      # recordings are kept where FILE_STORE says: data/recordings (local) or <S3_PREFIX>recordings/ (s3)
# RECORDING_RETENTION_DAYS=0           # delete recordings older than this; 0 = keep

# ── Bank systems ── when: demoing failures, or switching off personal questions
# BANK_PROVIDER=http                   # http (the bank's systems over HTTP: the embedded mock bank) | mock (in-process) | off
# BANK_BASE_URL=                       # empty = start the mock bank inside this process; else AU's gateway
# MOCKBANK_PORT=0                      # 8100 to browse the mock bank's /docs
# BANK_SERVICE_TOKEN=                  # brain -> bank; empty = random per process (set both when the bank runs separately)
# BANK_TOKEN_SECRET=
# MOCK_BANK_FAIL=                      # fault injection: cards:lost_response,cbs:latency=400 | read | card_update | all
# BANK_DATA_FILE=../Sample Questions/Inbound_Voice_Agent_Dummy_Data.xlsx   # seed source (never modified)
# DEMO_TODAY=                         # empty = today; the mock bank is seeded relative to it
# OTP_DELIVERY=simulated               # simulated = code shown in the test UI; never use in production
# DEMO_CALLERS=true                    # lists test customers for the UI's "calling from" picker; false in production
# POLICY_PACK=true                     # add the synthetic service-policy document to the KB once (labelled synthetic)

# ── Quality review and resilience (Phase 4) ──
# JUDGE_MODE=all                       # post-call review: all (development) | selective (production) | off
# JUDGE_MODEL=llama-3.3-70b-versatile  # a different model from the agent's: its quota is separate
# LLM_FALLBACK={"openai/gpt-oss-120b": "llama-3.3-70b-versatile"}   # only after the fallback passed the smoke set
# LLM_REPLAY_DIR=evals/cache           # evals only
# STT_VOCABULARY=extended              # base | extended | none (extended won the A/B test)

# ── People (agent desk) ── when: showing out-of-hours callbacks, or a shorter wait before a callback
# DESK_HOURS=00:00-23:59               # when teams are staffed, e.g. 08:00-20:00 (fraud is always 24x7)
# HANDOFF_WAIT_S=180                   # on hold this long with nobody picking up -> a callback is booked

# ── Storage ── when: using a real Postgres or S3/MinIO instead of the built-in local ones
# DATABASE_URL=postgresql://user:pass@host:5432/brain   # empty = private Postgres under data/pg
# FILE_STORE=s3                        # local (default) | s3
# S3_BUCKET=
# S3_ENDPOINT_URL=http://127.0.0.1:9000   # MinIO only

# ── Security ── when: anything other than your own laptop
# API_KEY=choose-a-long-random-secret  # required on write endpoints and voice (header X-API-Key)
# CORS_ORIGINS=https://your-ui-host    # which browser origins may call the API
# RATE_LIMIT_PER_MIN=120

# ── Search models ── when: the embed + rerank models run on a separate GPU search server (AWS)
# SEARCH_PROVIDER=local                # local (load them in this process, default) | http (GPU search server)
# SEARCH_URL=http://127.0.0.1:8200     # http: where `python -m app search` listens
# SEARCH_TOKEN=choose-a-long-random-secret  # http: the same value on the brain and the search server
# SEARCH_TIMEOUT_S=3                   # per question (one embed / one rerank)

# ── Tuning ── when: an evaluation shows a reason to change them
# DEVICE=auto                          # auto (GPU if present) | cpu | cuda
# MIN_RERANK_SCORE=0.03
# MAX_UPLOAD_MB=100                    # largest document upload
# END_SILENCE_MS=700                   # silence that ends the caller's turn
# BARGEIN_MIN_MS=350                   # caller speech needed to interrupt the agent
# LOG_LEVEL=INFO
# LOG_CONSOLE=text                     # text | json (for log shippers)
