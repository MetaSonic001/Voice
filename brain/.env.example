# Copy to .env. Only GROQ_API_KEY is needed for local development; everything else has a working default.
# Uncomment a line only when you need what it says. Names are case-insensitive (see app/config.py).

GROQ_API_KEY=gsk_your_key_here

# ── LLM ── when: moving off Groq (production on AWS uses Bedrock; credentials come from the IAM role)
# LLM_PROVIDER=bedrock                 # openai (default: any OpenAI-compatible API, Groq) | bedrock
# AWS_REGION=ap-south-1
# UNDERSTAND_MODEL=openai/gpt-oss-20b  # Bedrock: e.g. apac.anthropic.claude-haiku-4-5-20251001-v1:0
# ANSWER_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1   # another OpenAI-compatible provider (OpenAI, Azure, vLLM)

# ── Voice ── when: text-only testing (VOICE_ENABLED=false loads no voice models), or switching to Sarvam
# VOICE_ENABLED=true
# STT_PROVIDER=sarvam                  # groq (default, Whisper) | sarvam
# STT_MODEL=saaras:v3                  # with sarvam
# TTS_PROVIDER=sarvam                  # edge (default, free, dev only) | sarvam
# SARVAM_API_KEY=

# ── Personal questions (MVP 2) ── when: pointing at other test data, or a different "today"
# BANK_DATA_FILE=../Sample Questions/Inbound_Voice_Agent_Dummy_Data.xlsx   # empty = personal questions off
# DEMO_TODAY=2026-12-31                # the dummy transactions end on this date
# OTP_DELIVERY=simulated               # simulated = code shown in the test UI; never use in production
# DEMO_CALLERS=true                    # lists test customers for the UI's "calling from" picker; false in production

# ── Storage ── when: using a real Postgres or S3/MinIO instead of the built-in local ones
# DATABASE_URL=postgresql://user:pass@host:5432/brain   # empty = private Postgres under data/pg
# FILE_STORE=s3                        # local (default) | s3
# S3_BUCKET=
# S3_ENDPOINT_URL=http://127.0.0.1:9000   # MinIO only

# ── Security ── when: anything other than your own laptop
# API_KEY=choose-a-long-random-secret  # required on write endpoints and voice (header X-API-Key)
# CORS_ORIGINS=https://your-ui-host    # which browser origins may call the API
# RATE_LIMIT_PER_MIN=120

# ── Tuning ── when: an evaluation shows a reason to change them
# DEVICE=auto                          # auto (GPU if present) | cpu | cuda
# MIN_RERANK_SCORE=0.03
# END_SILENCE_MS=700                   # silence that ends the caller's turn
# BARGEIN_MIN_MS=350                   # caller speech needed to interrupt the agent
# LOG_LEVEL=INFO
# LOG_CONSOLE=text                     # text | json (for log shippers)
